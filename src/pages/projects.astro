---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const translations = {
	subtitle: { en: 'Selected Work', es: 'Trabajos Seleccionados', pt: 'Trabalhos Selecionados' },
	title: { en: 'Projects', es: 'Proyectos', pt: 'Projetos' },
	description: { en: 'A collection of projects showcasing my skills in full-stack development.', es: 'Una colección de proyectos que muestran mis habilidades en desarrollo full-stack.', pt: 'Uma coleção de projetos que mostram as minhas competências em desenvolvimento full-stack.' },
	comingSoon: { en: 'Coming soon', es: 'Próximamente', pt: 'Em breve' },
	viewProject: { en: 'View on itch.io', es: 'Ver en itch.io', pt: 'Ver no itch.io' }
};

// Carrega automaticamente todas as imagens das pastas de cada projeto
const bowBattlesImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/bow-battles/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const clagImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/code-like-a-girl/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const categories = [
	{
		id: 'game-dev',
		icon: '🎮',
		title: { en: 'Game Development', es: 'Desarrollo de Juegos', pt: 'Desenvolvimento de Jogos' },
		description: {
			en: 'Interactive games and playful experiments, focused on game logic, mechanics and user experience.',
			es: 'Juegos interactivos y experimentos lúdicos, centrados en la lógica de juego, las mecánicas y la experiencia de usuario.',
			pt: 'Jogos interativos e experiências lúdicas, com foco em lógica de jogo, mecânicas e experiência do utilizador.'
		},
		projects: [
			{
				name: 'Bow Battles',
				date: { en: '2026', es: '2026', pt: '2026' },
				link: 'https://itch.io',
				images: bowBattlesImages,
				description: {
					en: '2D fantasy game with 12 stages where the goal is to defeat the bosses. Includes a shop, menu, level system, sound system, 9 purchasable characters, movement, attack and revive mechanics. Released on itch.io.',
					es: 'Juego de fantasía 2D con 12 niveles cuyo objetivo es derrotar a los jefes. Incluye tienda, menú, sistema de niveles, sistema de sonido, 9 personajes comprables, movimiento, ataque y mecánica de resurrección. Publicado en itch.io.',
					pt: 'Jogo 2D de fantasia com 12 níveis, cujo objetivo é derrotar os bosses. Inclui loja, menu, sistema de níveis, sistema de som, 9 personagens compráveis, movimentação, ataque e sistema de reviver. Lançado no itch.io.'
				}
			}
		]
	},
	{
		id: 'backend',
		icon: '🗄️',
		title: { en: 'Backend', es: 'Backend', pt: 'Backend' },
		description: {
			en: 'APIs, databases and server-side logic, with attention to structure, security and performance.',
			es: 'APIs, bases de datos y lógica del lado del servidor, con atención a la estructura, la seguridad y el rendimiento.',
			pt: 'APIs, bases de dados e lógica do lado do servidor, com atenção à estrutura, segurança e desempenho.'
		},
		projects: []
	},
	{
		id: 'web-design',
		icon: '🎨',
		title: { en: 'Web Design', es: 'Diseño Web', pt: 'Web Design' },
		description: {
			en: 'Interface and layout work, focused on clean visuals, readability and responsive design.',
			es: 'Trabajo de interfaz y maquetación, centrado en un diseño limpio, la legibilidad y el diseño responsivo.',
			pt: 'Trabalho de interface e layout, com foco em visuais limpos, legibilidade e design responsivo.'
		},
		projects: []
	},
	{
		id: 'fullstack',
		icon: '⚙️',
		title: { en: 'Full Stack', es: 'Full Stack', pt: 'Full Stack' },
		description: {
			en: 'End-to-end applications, from the interface to the database, built as complete working solutions.',
			es: 'Aplicaciones de extremo a extremo, desde la interfaz hasta la base de datos, construidas como soluciones completas y funcionales.',
			pt: 'Aplicações de ponta a ponta, da interface à base de dados, construídas como soluções completas e funcionais.'
		},
		projects: []
	},
	{
		id: 'volunteering',
		icon: '🤝',
		title: { en: 'Volunteering', es: 'Voluntariado', pt: 'Voluntariado' },
		description: {
			en: 'Community and educational initiatives, including teaching, outreach and technology awareness activities.',
			es: 'Iniciativas comunitarias y educativas, incluyendo enseñanza, divulgación y actividades de sensibilización tecnológica.',
			pt: 'Iniciativas comunitárias e educativas, incluindo ensino, divulgação e atividades de sensibilização para a tecnologia.'
		},
		projects: [
			{
				name: 'Code Like A Girl',
				date: { en: '2026', es: '2026', pt: '2026' },
				link: null,
				images: clagImages,
				description: {
					en: 'Volunteer programming trainer for young girls, teaching coding fundamentals and adapting explanations to each participant\'s pace, encouraging confidence and interest in technology.',
					es: 'Formadora voluntaria de programación para niñas, enseñando los fundamentos de la programación y adaptando las explicaciones al ritmo de cada participante, fomentando la confianza y el interés por la tecnología.',
					pt: 'Formadora voluntária de programação para meninas, ensinando fundamentos de código e adaptando as explicações ao ritmo de cada participante, incentivando a confiança e o interesse pela tecnologia.'
				}
			}
		]
	}
];
---

<Layout title="Projects | Jacinta Chemane">
	<Header />

	<main class="min-h-screen px-4 sm:px-6 md:px-6">
		<section class="max-w-3xl mx-auto min-h-[calc(100vh-5rem)] pt-24 sm:pt-32 md:pt-48 pb-16 sm:pb-24 fade-in px-2 sm:px-0">
			<div class="max-w-2xl mb-12 sm:mb-16">
				<p class="text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400 mb-3 sm:mb-4 tracking-wider uppercase" data-en={translations.subtitle.en} data-es={translations.subtitle.es} data-pt={translations.subtitle.pt}>{translations.subtitle.pt}</p>
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-white" data-en={translations.title.en} data-es={translations.title.es} data-pt={translations.title.pt}>
					{translations.title.pt}
				</h1>
				<p class="mt-3 sm:mt-4 text-sm sm:text-lg text-gray-600 dark:text-gray-400" data-en={translations.description.en} data-es={translations.description.es} data-pt={translations.description.pt}>
					{translations.description.pt}
				</p>
			</div>

			<!-- Categorias em formato de gaveta (nível 1) -->
			<div class="space-y-3 sm:space-y-4">
				{categories.map((cat, index) => (
					<details id={cat.id} class="category-drawer scroll-mt-28" open={index === 0}>
						<summary class="category-summary">
							<span class="text-2xl sm:text-3xl flex-shrink-0" aria-hidden="true">{cat.icon}</span>
							<div class="flex-1 min-w-0">
								<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5">
									<h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white" data-en={cat.title.en} data-es={cat.title.es} data-pt={cat.title.pt}>
										{cat.title.pt}
									</h2>
									{cat.projects.length === 0 && (
										<span class="text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 w-fit whitespace-nowrap" data-en={translations.comingSoon.en} data-es={translations.comingSoon.es} data-pt={translations.comingSoon.pt}>
											{translations.comingSoon.pt}
										</span>
									)}
								</div>
								<p class="mt-1 text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed" data-en={cat.description.en} data-es={cat.description.es} data-pt={cat.description.pt}>
									{cat.description.pt}
								</p>
							</div>
							<svg class="chevron-icon flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</summary>

						<div class="category-content">
							{cat.projects.length > 0 && (
								<div class="space-y-3 pt-3">
									{cat.projects.map((project) => (
										<!-- Cada projeto é a sua própria gaveta (nível 2) -->
										<details class="project-drawer">
											<summary class="project-summary">
												<div class="flex-1 min-w-0">
													<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
														<h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">{project.name}</h3>
														<span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-medium" data-en={project.date.en} data-es={project.date.es} data-pt={project.date.pt}>
															{project.date.pt}
														</span>
													</div>
												</div>
												<svg class="chevron-icon flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<polyline points="6 9 12 15 18 9"></polyline>
												</svg>
											</summary>

											<div class="project-content">
												{project.images.length > 0 && (
													<div class="project-gallery">
														{project.images.map((img, i) => (
															<img
																src={img.src}
																width={img.width}
																height={img.height}
																alt={`${project.name} — ${i + 1}`}
																loading="lazy"
																decoding="async"
																class="project-gallery-img"
															/>
														))}
													</div>
												)}
												<p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed mt-3" data-en={project.description.en} data-es={project.description.es} data-pt={project.description.pt}>
													{project.description.pt}
												</p>
												{project.link && (
													<a
														href={project.link}
														target="_blank"
														rel="noopener noreferrer"
														class="animated-border inline-flex items-center gap-2 mt-4 px-4 py-2 text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
														data-en={translations.viewProject.en}
														data-es={translations.viewProject.es}
														data-pt={translations.viewProject.pt}
													>
														{translations.viewProject.pt}
													</a>
												)}
											</div>
										</details>
									))}
								</div>
							)}
						</div>
					</details>
				))}
			</div>
		</section>
	</main>

	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) entry.target.classList.add('visible');
				});
			}, { threshold: 0.1 });

			document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
		});
	</script>
</Layout>

<style>
	@reference "../styles/global.css";

	/* Gaveta de categoria (nível 1) */
	.category-drawer {
		border: 1px solid rgb(229 231 235);
		border-radius: 1rem;
		background: white;
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	:global(html.dark) .category-drawer {
		border-color: rgb(55 65 81);
		background: rgb(3 7 18 / 0.4);
	}

	.category-drawer:hover {
		border-color: rgb(156 163 175);
	}

	:global(html.dark) .category-drawer:hover {
		border-color: rgb(107 114 128);
	}

	.category-summary {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1.1rem 1.25rem;
		cursor: pointer;
		list-style: none;
	}

	.category-summary::-webkit-details-marker,
	.project-summary::-webkit-details-marker {
		display: none;
	}

	.category-summary::marker,
	.project-summary::marker {
		content: '';
	}

	.chevron-icon {
		margin-top: 0.35rem;
		color: rgb(107 114 128);
		transition: transform 0.3s ease;
	}

	details[open] > summary .chevron-icon {
		transform: rotate(180deg);
	}

	.category-content {
		padding: 0 1.25rem 1.1rem 1.25rem;
	}

	@keyframes drawer-open {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	details[open] > .category-content,
	details[open] > .project-content {
		animation: drawer-open 0.25s ease;
	}

	/* Gaveta de projeto (nível 2) */
	.project-drawer {
		border: 1px solid rgb(229 231 235);
		border-radius: 0.85rem;
		overflow: hidden;
		background: rgb(249 250 251);
		transition: border-color 0.2s ease;
	}

	:global(html.dark) .project-drawer {
		border-color: rgb(55 65 81);
		background: rgb(17 24 39 / 0.5);
	}

	.project-drawer:hover {
		border-color: rgb(156 163 175);
	}

	:global(html.dark) .project-drawer:hover {
		border-color: rgb(107 114 128);
	}

	.project-summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		cursor: pointer;
		list-style: none;
	}

	.project-content {
		padding: 0 1rem 1rem 1rem;
	}

	.project-gallery {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 0.5rem 0;
		-webkit-overflow-scrolling: touch;
	}

	.project-gallery::-webkit-scrollbar {
		height: 6px;
	}

	.project-gallery::-webkit-scrollbar-thumb {
		background: rgb(156 163 175 / 0.6);
		border-radius: 9999px;
	}

	.project-gallery-img {
		flex: 0 0 auto;
		width: 15rem;
		height: 10rem;
		object-fit: cover;
		border-radius: 0.75rem;
		scroll-snap-align: start;
		transition: transform 0.3s ease;
	}

	.project-gallery-img:hover {
		transform: scale(1.03);
	}

	@media (max-width: 640px) {
		.project-gallery-img {
			width: 12rem;
			height: 8rem;
		}
	}
</style>