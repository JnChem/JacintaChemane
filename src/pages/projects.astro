---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const translations = {
	title: { en: 'Projects', es: 'Proyectos', pt: 'Projetos' },
	description: { en: 'A collection of projects showcasing my skills.', es: 'Una colección de proyectos que muestran mis habilidades.', pt: 'Uma coleção de projetos que mostram as minhas competências.' },
	comingSoon: { en: 'Coming soon', es: 'Próximamente', pt: 'Em breve' },
	viewProject: { en: 'View on itch.io', es: 'Ver en itch.io', pt: 'Ver no itch.io' }
};

// Carrega automaticamente todas as imagens das pastas de cada projeto
const bowBattlesImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/bow-battles/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const clagImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/code-like-a-girl/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const silImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/sil/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const silBackendImages = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/projects/mySQL/*.{png,jpg,jpeg,webp,avif}', { eager: true })
).map((img) => img.default);

const categories = [
	{
		id: 'game-dev',
		title: { en: 'Game Development', es: 'Desarrollo de Juegos', pt: 'Desenvolvimento de Jogos' },
		description: {
			en: 'Simple games with a focus on gameplay and mechanics.',
			es: 'Juegos sencillos con foco en la jugabilidad y las mecánicas.',
			pt: 'Jogos simples com foco em jogabilidade e mecânicas.'
		},
		projects: [
			{
				name: 'Bow Battles',
				date: { en: 'January 5th 2024', es: '5 de enero de 2024', pt: '5 de janeiro de 2024' },
				link: 'https://jncstudios.itch.io/bow-battles',
				images: bowBattlesImages,
				intro: {
					en: '2D fantasy game with 12 stages, where the goal is to defeat the boss of each stage. Built with C# in Unity. Released on itch.io.',
					es: 'Juego de fantasía 2D con 12 niveles, cuyo objetivo es derrotar al jefe de cada nivel. Desarrollado con C# en Unity. Publicado en itch.io.',
					pt: 'Jogo 2D de fantasia com 12 níveis, cujo objetivo é derrotar o boss de cada nível. Desenvolvido com C# em Unity. Lançado no itch.io.'
				},
				featuresLabel: { en: 'Features:', es: 'Funcionalidades:', pt: 'Funcionalidades:' },
				features: [
					{ en: 'Shop', es: 'Tienda', pt: 'Loja' },
					{ en: 'Menu', es: 'Menú', pt: 'Menu' },
					{ en: 'Level system', es: 'Sistema de niveles', pt: 'Sistema de níveis' },
					{ en: 'Sound system', es: 'Sistema de sonido', pt: 'Sistema de som' },
					{ en: '9 purchasable characters', es: '9 personajes comprables', pt: '9 personagens compráveis' },
					{ en: 'Movement', es: 'Movimiento', pt: 'Movimentação' },
					{ en: 'Attack', es: 'Ataque', pt: 'Ataque' },
					{ en: 'Revive mechanic', es: 'Mecánica de resurrección', pt: 'Sistema de reviver' },
					{ en: 'Audio integration', es: 'Integración de audio', pt: 'Integração de áudio' },
					{ en: 'UI built with templates', es: 'UI construida con plantillas', pt: 'UI construída com templates' }
				]
			}
		]
	},
	{
		id: 'backend',
		title: { en: 'Backend', es: 'Backend', pt: 'Backend' },
		description: {
			en: 'APIs and databases.',
			es: 'APIs y bases de datos.',
			pt: 'APIs e bases de dados.'
		},
		projects: [
			{
				name: 'SIL - Stack: PHP, Node.js, Express, MySQL',
				date: { en: '2025', es: '2025', pt: '2025' },
				link: null,
				images: silBackendImages,
				intro: {
					en: 'Development of the database and API for the SIL platform. The API was built with Node.js and Express, and the connection to the MySQL database was made through PHP. The schema and endpoints structure the data behind user accounts, real-time locations, emergency alerts and authorized contacts.',
					es: 'Desarrollo de la base de datos y de la API de la plataforma SIL. La API fue construida con Node.js y Express, y la conexión con la base de datos MySQL se realizó mediante PHP. El esquema y los endpoints estructuran los datos detrás de las cuentas de usuario, ubicaciones en tiempo real, alertas de emergencia y contactos autorizados.',
					pt: 'Desenvolvimento da base de dados e da API da plataforma SIL. A API foi construída com Node.js e Express, e a ligação à base de dados MySQL foi feita através de PHP. O esquema e os endpoints estruturam os dados por trás das contas de utilizador, localizações em tempo real, alertas de emergência e contactos autorizados.'
				},
				featuresLabel: { en: 'What it includes:', es: 'Lo que incluye:', pt: 'O que inclui:' },
				features: [
					{ en: 'Relational schema in MySQL for users, locations, SOS alerts, contacts and profiles', es: 'Esquema relacional en MySQL para usuarios, ubicaciones, alertas SOS, contactos y perfiles', pt: 'Esquema relacional em MySQL para utilizadores, localizações, alertas SOS, contactos e perfis' },
					{ en: 'REST API endpoints (Node.js/Express) for authentication, location tracking and emergency alerts', es: 'Endpoints de API REST (Node.js/Express) para autenticación, seguimiento de ubicación y alertas de emergencia', pt: 'Endpoints de API REST (Node.js/Express) para autenticação, rastreio de localização e alertas de emergência' },
					{ en: 'Password encryption and basic authentication logic', es: 'Encriptación de contraseñas y lógica básica de autenticación', pt: 'Encriptação de passwords e lógica básica de autenticação' }
				],
				techLabel: { en: 'Tech stack:', es: 'Tecnologías:', pt: 'Tecnologias:' },
				tech: ['MySQL', 'Node.js', 'Express', 'PHP']
			}
		]
	},
	{
		id: 'web-design',
		title: { en: 'Web Design', es: 'Diseño Web', pt: 'Web Design' },
		description: {
			en: 'Simple, responsive interfaces.',
			es: 'Interfaces sencillas y responsivas.',
			pt: 'Interfaces simples e responsivas.'
		},
		projects: []
	},
	{
		id: 'fullstack',
		title: { en: 'Full Stack', es: 'Full Stack', pt: 'Full Stack' },
		description: {
			en: 'Complete applications, from interface to database.',
			es: 'Aplicaciones completas, desde la interfaz hasta la base de datos.',
			pt: 'Aplicações completas, da interface à base de dados.'
		},
		projects: [
			{
				name: 'SIL — Plataforma de Localização',
				date: { en: '2025', es: '2025', pt: '2025' },
				link: null,
				images: silImages,
				intro: {
					en: 'Localization Platform for Public and Family Safety, an academic project researching technological solutions to support safety in Mozambique. Provides an efficient real-time location system focused on preventing and responding to risk situations, letting friends and family track location, receive emergency alerts and check frequent places. Developed as a final course project (Trabalho de Conclusão de Curso) in 2025.',
					es: 'Plataforma de Localización para la Seguridad Pública y Familiar, un proyecto académico de investigación sobre soluciones tecnológicas para apoyar la seguridad en Mozambique. Ofrece un sistema eficiente de localización en tiempo real, centrado en prevenir y responder a situaciones de riesgo, permitiendo que amigos y familiares sigan la ubicación, reciban alertas de emergencia y consulten lugares frecuentes. Desarrollado como proyecto final de curso en 2025.',
					pt: 'Plataforma de Localização - Segurança Pública e Familiar, um projeto académico desenvolvido no âmbito da pesquisa sobre soluções tecnológicas para apoio à segurança em Moçambique. Disponibiliza um sistema eficiente de localização em tempo real, focado em prevenir e responder a situações de risco, permitindo que amigos e familiares acompanhem a localização, recebam alertas de emergência e consultem locais frequentes. Desenvolvido como Trabalho de Conclusão de Curso em 2025.'
				},
				featuresLabel: { en: 'Main features:', es: 'Funcionalidades principales:', pt: 'Funcionalidades principais:' },
				features: [
					{ en: 'Real-time location monitoring', es: 'Monitoreo de ubicación en tiempo real', pt: 'Monitoramento de localização em tempo real' },
					{ en: 'Panic button with emergency alerts', es: 'Botón de pánico y envío de alertas de emergencia', pt: 'Botão de pânico e envio de alertas emergenciais' },
					{ en: 'Location history', es: 'Historial de ubicaciones', pt: 'Histórico de localizações' },
					{ en: 'Profile and authorized contact management', es: 'Gestión de perfiles y contactos autorizados', pt: 'Gestão de perfis e contatos autorizados' }
				],
				techLabel: { en: 'Tech stack:', es: 'Tecnologías:', pt: 'Tecnologias:' },
				tech: ['React', 'Leaflet', 'Bootstrap', 'Node.js', 'Express', 'PHP', 'MySQL']
			}
		]
	},
	{
		id: 'volunteering',
		title: { en: 'Volunteering', es: 'Voluntariado', pt: 'Voluntariado' },
		description: {
			en: 'Volunteer teaching and community coordination.',
			es: 'Docencia voluntaria y coordinación comunitaria.',
			pt: 'Ensino voluntário e coordenação comunitária.'
		},
		projects: [
			{
				name: 'Code Like A Girl',
				date: { en: 'August 31 – September 5, 2026', es: '31 de agosto al 5 de septiembre de 2026', pt: '31 de agosto a 5 de setembro de 2026' },
				link: null,
				images: clagImages,
				intro: {
					en: 'Volunteer trainer for the Code Like A Girl program by Moz Devz, sponsored by Vodacom Moçambique, teaching young girls with no prior contact with technology.',
					es: 'Formadora voluntaria en el programa Code Like A Girl por Moz Devz, patrocinado por Vodacom Mozambique, enseñando a niñas sin contacto previo con la tecnología.',
					pt: 'Formadora voluntária no programa Code Like A Girl da Moz Devz, patrocinado pela Vodacom Moçambique, ensinando meninas sem contacto prévio com a tecnologia.'
				},
				featuresLabel: { en: 'What I did:', es: 'Lo que hice:', pt: 'O que fiz:' },
				features: [
					{ en: 'Taught computing fundamentals, the Internet, client-server architecture and the Internet of Things', es: 'Impartí fundamentos de informática, Internet, arquitectura cliente-servidor e Internet de las Cosas', pt: 'Leccionei módulos de informática, Internet, arquitetura cliente-servidor e Internet das Coisas' },
					{ en: 'Delivered cybersecurity training for safe and conscious online navigation', es: 'Formación en ciberseguridad para una navegación online segura y consciente', pt: 'Formação em segurança cibernética para navegação online consciente e protegida' },
					{ en: 'Introduced web development with HTML, CSS and JavaScript', es: 'Introduje desarrollo web con HTML, CSS y JavaScript', pt: 'Introdução ao desenvolvimento web com HTML, CSS e JavaScript' },
					{ en: 'Taught UX/UI basics', es: 'Enseñé fundamentos de UX/UI', pt: 'Ensinei fundamentos de UX/UI' },
					{ en: 'Designed and adapted teaching materials for beginners', es: 'Diseño y adaptación de materiales didácticos para principiantes', pt: 'Conceção e adaptação de conteúdos didáticos para iniciantes' },
					{ en: 'Coordinated practical sessions with another trainer', es: 'Coordinación de sesiones prácticas junto a otro formador', pt: 'Coordenação de sessões práticas em conjunto com outro formador' }
				]
			}
		]
	}
];
---

<Layout title="Projects | Jacinta Chemane">
	<Header />

	<main class="min-h-screen px-4 sm:px-6 md:px-6">
		<section class="max-w-3xl mx-auto min-h-[calc(100vh-5rem)] pt-24 sm:pt-32 md:pt-48 pb-16 sm:pb-24 fade-in px-2 sm:px-0">
			<div class="max-w-2xl mb-12 sm:mb-16">
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-white" data-en={translations.title.en} data-es={translations.title.es} data-pt={translations.title.pt}>
					{translations.title.pt}
				</h1>
				<p class="mt-3 sm:mt-4 text-sm sm:text-lg text-gray-600 dark:text-gray-400" data-en={translations.description.en} data-es={translations.description.es} data-pt={translations.description.pt}>
					{translations.description.pt}
				</p>
			</div>

			<!-- Categorias: títulos simples, sempre visíveis -->
			<div class="space-y-10 sm:space-y-14">
				{categories.map((cat) => (
					<div id={cat.id} class="scroll-mt-28">
						<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
							<h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white" data-en={cat.title.en} data-es={cat.title.es} data-pt={cat.title.pt}>
								{cat.title.pt}
							</h2>
							{cat.projects.length === 0 && (
								<span class="text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 w-fit whitespace-nowrap" data-en={translations.comingSoon.en} data-es={translations.comingSoon.es} data-pt={translations.comingSoon.pt}>
								{translations.comingSoon.pt}
							</span>
							)}
						</div>
						<p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed mb-4 sm:mb-5" data-en={cat.description.en} data-es={cat.description.es} data-pt={cat.description.pt}>
							{cat.description.pt}
						</p>

						<!-- Projetos: cada um é uma gaveta expansível -->
						{cat.projects.length > 0 && (
							<div class="space-y-3">
								{cat.projects.map((project) => (
									<details class="project-drawer">
										<summary class="project-summary">
											<div class="flex-1 min-w-0">
												<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
													<h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">{project.name}</h3>
													<span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-medium" data-en={project.date.en} data-es={project.date.es} data-pt={project.date.pt}>
														{project.date.pt}
													</span>
												</div>
											</div>
											<svg class="chevron-icon flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<polyline points="6 9 12 15 18 9"></polyline>
											</svg>
										</summary>

										<div class="project-content">
											{project.images.length > 0 && (
												<div class="project-gallery">
													{project.images.map((img, i) => (
														<img
															src={img.src}
															width={img.width}
															height={img.height}
															alt={`${project.name} — ${i + 1}`}
															loading="lazy"
															decoding="async"
															class="project-gallery-img"
														/>
													))}
												</div>
											)}
											<p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed mt-3" data-en={project.intro.en} data-es={project.intro.es} data-pt={project.intro.pt}>
												{project.intro.pt}
											</p>
											{project.features && project.features.length > 0 && (
												<div class="mt-3">
													<p class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white mb-1.5" data-en={project.featuresLabel.en} data-es={project.featuresLabel.es} data-pt={project.featuresLabel.pt}>
														{project.featuresLabel.pt}
													</p>
													<ul class="feature-list">
														{project.features.map((feature) => (
															<li data-en={feature.en} data-es={feature.es} data-pt={feature.pt}>{feature.pt}</li>
														))}
													</ul>
												</div>
											)}
											{project.tech && project.tech.length > 0 && (
												<div class="mt-3">
													<p class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white mb-1.5" data-en={project.techLabel.en} data-es={project.techLabel.es} data-pt={project.techLabel.pt}>
														{project.techLabel.pt}
													</p>
													<div class="tech-tags">
														{project.tech.map((t) => (
															<span class="tech-tag">{t}</span>
														))}
													</div>
												</div>
											)}
											{project.link && (
												<a
													href={project.link}
													target="_blank"
													rel="noopener noreferrer"
													class="animated-border inline-flex items-center gap-2 mt-4 px-4 py-2 text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
													data-en={translations.viewProject.en}
													data-es={translations.viewProject.es}
													data-pt={translations.viewProject.pt}
												>
													{translations.viewProject.pt}
												</a>
											)}
										</div>
									</details>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</main>

	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) entry.target.classList.add('visible');
				});
			}, { threshold: 0.1 });

			document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
		});
	</script>
</Layout>

<style>
	@reference "../styles/global.css";

		.project-drawer {
		border: 1px solid rgb(229 231 235);
		border-radius: 0.85rem;
		overflow: hidden;
		background: rgb(249 250 251);
		transition: border-color 0.2s ease;
	}

	:global(html.dark) .project-drawer {
		border-color: rgb(55 65 81);
		background: rgb(17 24 39 / 0.5);
	}

	.project-drawer:hover {
		border-color: rgb(156 163 175);
	}

	:global(html.dark) .project-drawer:hover {
		border-color: rgb(107 114 128);
	}

	.project-summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		cursor: pointer;
		list-style: none;
	}

	.project-summary::-webkit-details-marker {
		display: none;
	}

	.project-summary::marker {
		content: '';
	}

	.chevron-icon {
		color: rgb(107 114 128);
		transition: transform 0.3s ease;
	}

	.project-drawer[open] .chevron-icon {
		transform: rotate(180deg);
	}

	.project-content {
		padding: 0 1rem 1rem 1rem;
	}

	@keyframes drawer-open {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.project-drawer[open] .project-content {
		animation: drawer-open 0.25s ease;
	}

	.feature-list {
		list-style: disc;
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.875rem;
		color: rgb(75 85 99);
	}

	:global(html.dark) .feature-list {
		color: rgb(156 163 175);
	}

	@media (min-width: 640px) {
		.feature-list {
			font-size: 1rem;
		}
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-tag {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		background: rgb(229 231 235);
		color: rgb(55 65 81);
	}

	:global(html.dark) .tech-tag {
		background: rgb(55 65 81);
		color: rgb(209 213 219);
	}

	.project-gallery {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 0.5rem 0;
		-webkit-overflow-scrolling: touch;
	}

	.project-gallery::-webkit-scrollbar {
		height: 6px;
	}

	.project-gallery::-webkit-scrollbar-thumb {
		background: rgb(156 163 175 / 0.6);
		border-radius: 9999px;
	}

	.project-gallery-img {
		flex: 0 0 auto;
		width: 15rem;
		height: 10rem;
		object-fit: contain;
		background: rgb(229 231 235);
		border-radius: 0.75rem;
		scroll-snap-align: start;
		transition: transform 0.3s ease;
	}

	:global(html.dark) .project-gallery-img {
		background: rgb(31 41 55);
	}

	.project-gallery-img:hover {
		transform: scale(1.03);
	}

	@media (max-width: 640px) {
		.project-gallery-img {
			width: 12rem;
			height: 8rem;
		}
	}
</style>